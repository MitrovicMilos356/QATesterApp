<Window x:Class="UiInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UiInspector.App"
        Title="UI Inspector"
        Width="1100" Height="720" MinWidth="720" MinHeight="420"
        Background="White"
        FontFamily="Segoe UI" FontSize="13"
        AutomationProperties.AutomationId="UiInspectorMainWindow">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="ToolButton" TargetType="ButtonBase">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>

        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
            <Setter Property="Padding" Value="1,1"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <WrapPanel VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource ToolButton}" IsChecked="{Binding LivePickEnabled}"
                              AutomationProperties.AutomationId="LivePickToggle"
                              ToolTip="Hold Ctrl and hover over any app; release Ctrl to pick. Toggle: Ctrl+Shift+F12">
                    <TextBlock><Run FontWeight="SemiBold" Text="Live pick"/><Run Foreground="{StaticResource MutedBrush}" Text="  (hold Ctrl)"/></TextBlock>
                </ToggleButton>
                <Button Style="{StaticResource ToolButton}" Command="{Binding InspectFocusedCommand}"
                        AutomationProperties.AutomationId="InspectFocusedButton"
                        Content="Focused element" ToolTip="Inspect the element with keyboard focus. Works from any app: Ctrl+Shift+F10"/>
                <Button Style="{StaticResource ToolButton}" Command="{Binding DelayedCaptureCommand}"
                        AutomationProperties.AutomationId="DelayedCaptureButton"
                        Content="{Binding DelayedCaptureText}"
                        ToolTip="For menus and tooltips: click, open the menu in the target app, keep the cursor on the item. Hotkey: Ctrl+Shift+F11"/>
                <Button Style="{StaticResource ToolButton}" Command="{Binding BrowseWindowsCommand}"
                        AutomationProperties.AutomationId="BrowseWindowsButton"
                        Content="Browse windows" ToolTip="List every top-level window and pick from the tree: for hidden, covered or off-screen elements"/>
                <Separator Margin="4,2,10,2"/>
                <CheckBox VerticalAlignment="Center" Margin="0,0,14,0" IsChecked="{Binding SmartTargetEnabled}"
                          AutomationProperties.AutomationId="SmartTargetCheckBox"
                          Content="Smart target" ToolTip="When you point at a label or icon inside a control, select the control (button, link, list item…) instead"/>
                <CheckBox VerticalAlignment="Center" Margin="0,0,14,0" IsChecked="{Binding HighlightEnabled}"
                          AutomationProperties.AutomationId="HighlightCheckBox"
                          Content="Highlight on screen"/>
                <Button Style="{StaticResource ToolButton}" Command="{Binding CopyDetailsCommand}"
                        AutomationProperties.AutomationId="CopyDetailsButton"
                        Content="Copy details"/>
            </WrapPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="10,5" Background="#F9FAFB">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}"
                           Text="Ctrl+Shift+F9 pick under cursor · F10 focused · F11 delayed · F12 live pick on/off · F8 record · F7 add check"/>
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"
                           AutomationProperties.AutomationId="StatusText"/>
            </DockPanel>
        </Border>

        <!-- Banner (smart target / web content hints) -->
        <Border DockPanel.Dock="Top" Padding="12,8" Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource InfoBackBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BannerIsWarning}" Value="True">
                            <Setter Property="Background" Value="{StaticResource WarningBackBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center"
                        Command="{Binding SelectPickedElementCommand}"
                        Visibility="{Binding CanSelectPickedElement, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="SelectPickedElementButton"
                        Content="Select what I pointed at"/>
                <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="BannerText"/>
            </DockPanel>
        </Border>

        <!-- Main area: the inspector, and the bug report across the whole window -->
        <TabControl Margin="6,6,6,0" AutomationProperties.AutomationId="MainTabs">
        <TabItem Header="Inspector" AutomationProperties.AutomationId="InspectorTab">
        <Grid Margin="4,6,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="260"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="4*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Element tree -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Element tree" FontWeight="SemiBold" Margin="2,0,0,6"/>
                <TreeView x:Name="ElementTree" ItemsSource="{Binding RootNodes}"
                          ItemContainerStyle="{StaticResource TreeItemStyle}"
                          BorderBrush="{StaticResource PanelBorderBrush}"
                          SelectedItemChanged="ElementTree_SelectedItemChanged"
                          TreeViewItem.Selected="ElementTree_ItemSelected"
                          VirtualizingPanel.IsVirtualizing="True"
                          AutomationProperties.AutomationId="ElementTree">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type local:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶ " Foreground="#DC2626"
                                           Visibility="{Binding IsHitElement, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="{Binding TypeText}" Foreground="{StaticResource TypeBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnPath}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding NameText}" Margin="5,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding IdText}" Foreground="{StaticResource IdBrush}" Margin="6,0,0,0"/>
                                <TextBlock Text="{Binding ClassText}" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Details -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                    <TextBlock Text="{Binding DetailTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="DetailTitle"/>
                    <TextBlock Text="{Binding DetailSubtitle}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreview}" Value="True">
                                        <Setter Property="Foreground" Value="#B45309"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TabControl AutomationProperties.AutomationId="DetailTabs">
                <TabItem Header="Properties" AutomationProperties.AutomationId="PropertiesTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Properties}" Margin="8,6" AutomationProperties.AutomationId="PropertiesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PropertyRow}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}"/>
                                        <!-- Read-only TextBox so values can be selected and copied. -->
                                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent" Padding="0"
                                                 TextWrapping="Wrap" AutomationProperties.Name="{Binding Name}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Selector &amp; code" AutomationProperties.AutomationId="SelectorTab">
                    <DockPanel Margin="8,8,8,6">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding SelectorHeadline}" TextWrapping="Wrap" FontWeight="SemiBold"
                                       AutomationProperties.AutomationId="SelectorHeadline">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectorTone}" Value="ok">
                                                <Setter Property="Foreground" Value="#15803D"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectorTone}" Value="bad">
                                                <Setter Property="Foreground" Value="#B91C1C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding SelectorChoices}" SelectedItem="{Binding SelectedChoice}"
                                      DisplayMemberPath="Label" ToolTip="Other verified selectors for the same element"
                                      Visibility="{Binding HasAlternatives, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.AutomationId="SelectorChoices"/>

                            <TextBox Margin="0,8,0,0" Text="{Binding SelectorSteps, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="#F9FAFB" Padding="6,4"
                                     TextWrapping="Wrap" AutomationProperties.AutomationId="SelectorSteps"/>

                            <ItemsControl ItemsSource="{Binding SelectorWarnings}" Margin="0,6,0,0" AutomationProperties.AutomationId="SelectorWarnings">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='⚠ {0}'}" TextWrapping="Wrap" Foreground="#B45309" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding OcclusionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       AutomationProperties.AutomationId="OcclusionText">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OcclusionIsWarning}" Value="True">
                                                <Setter Property="Foreground" Value="#B45309"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="3"
                                    Visibility="{Binding HasWebSummary, Converter={StaticResource BoolToVisibility}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource InfoBackBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WebIsWarning}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource WarningBackBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBox Text="{Binding WebSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         BorderThickness="0" Background="Transparent" Padding="0"
                                         AutomationProperties.AutomationId="WebSummary"/>
                            </Border>

                            <DockPanel Margin="0,10,0,6">
                                <Button DockPanel.Dock="Right" Padding="10,3" Content="Copy code" Command="{Binding CopyCodeCommand}"
                                        AutomationProperties.AutomationId="CopyCodeButton"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center"
                                            ToolTip="Chromium remote-debugging port for web code. Leave empty to read it from the app's command line.">
                                    <TextBlock Text="Debug port" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Width="52" Text="{Binding CdpPortText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="CdpPortBox" AutomationProperties.Name="Debug port"/>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding Snippets}" SelectedItem="{Binding SelectedSnippet}" DisplayMemberPath="Title"
                                          Margin="0,0,8,0" AutomationProperties.AutomationId="LanguageChoice"/>
                            </DockPanel>
                        </StackPanel>

                        <TextBox Text="{Binding SelectedSnippet.Code, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12" Padding="6"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.AutomationId="CodeText"/>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Recorder" AutomationProperties.AutomationId="RecorderTab" DataContext="{Binding Recorder}">
                    <DockPanel Margin="8,8,8,6">
                        <StackPanel DockPanel.Dock="Top">
                            <WrapPanel>
                                <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleRecordingCommand}"
                                        AutomationProperties.AutomationId="RecordButton"
                                        ToolTip="Start or stop recording. Works from any app: Ctrl+Shift+F8">
                                    <TextBlock Text="{Binding RecordButtonText}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Style="{StaticResource ToolButton}" Command="{Binding AddCheckDelayedCommand}"
                                        Content="{Binding CheckButtonText}" AutomationProperties.AutomationId="AddCheckButton"
                                        ToolTip="Adds a step that checks the element under the cursor: its text, or that it exists. While recording, Ctrl+Shift+F7 does it at once."/>
                                <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteStepCommand}"
                                        Content="Delete step" AutomationProperties.AutomationId="DeleteStepButton"/>
                                <Button Style="{StaticResource ToolButton}" Command="{Binding ClearCommand}"
                                        Content="Clear" AutomationProperties.AutomationId="ClearStepsButton"/>
                                <CheckBox VerticalAlignment="Center" Margin="4,0,0,0" IsChecked="{Binding CaptureScreenshots}"
                                          Content="Screenshots" AutomationProperties.AutomationId="CaptureScreenshotsCheckBox"
                                          ToolTip="Takes a picture of the app's window (only that window) at each step, for the bug report"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                                       AutomationProperties.AutomationId="RecorderStatus"/>
                        </StackPanel>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" MinHeight="80"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3*" MinHeight="80"/>
                            </Grid.RowDefinitions>

                            <ListBox Grid.Row="0" Margin="0,8,0,0" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                                     BorderBrush="{StaticResource PanelBorderBrush}" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.AutomationId="RecordedSteps" AutomationProperties.Name="Recorded steps">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:StepRow}">
                                        <StackPanel Margin="2,3">
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Number, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=". "/><Run Text="{Binding Text, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Margin="14,1,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tone}" Value="ok">
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tone}" Value="warn">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tone}" Value="bad">
                                                                <Setter Property="Foreground" Value="#B91C1C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <DockPanel Grid.Row="1" Margin="0,8,0,6">
                                <Button DockPanel.Dock="Right" Padding="10,3" Content="Save…" Command="{Binding SaveScriptCommand}"
                                        AutomationProperties.AutomationId="SaveScriptButton" AutomationProperties.Name="Save script"/>
                                <Button DockPanel.Dock="Right" Padding="10,3" Margin="0,0,6,0" Content="Copy script" Command="{Binding CopyScriptCommand}"
                                        AutomationProperties.AutomationId="CopyScriptButton"/>
                                <ComboBox ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript}" DisplayMemberPath="Title"
                                          Margin="0,0,8,0" AutomationProperties.AutomationId="ScriptLanguage" AutomationProperties.Name="Script language"/>
                            </DockPanel>

                            <TextBox Grid.Row="2" Text="{Binding SelectedScript.Code, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="12" Padding="6"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.AutomationId="ScriptText" AutomationProperties.Name="Recorded script"/>
                        </Grid>
                    </DockPanel>
                </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
        </TabItem>

        <TabItem Header="Bug report" AutomationProperties.AutomationId="BugReportTab" DataContext="{Binding BugReport}">
            <Grid Margin="4,6,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="370" MinWidth="300"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <!-- What the tester writes, and what goes into the report -->
                <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <WrapPanel>
                            <Button Style="{StaticResource ToolButton}" Content="Save HTML…" Command="{Binding SaveHtmlCommand}"
                                    AutomationProperties.AutomationId="SaveHtmlButton"
                                    ToolTip="One file with everything, screenshots included: ready to attach or e-mail"/>
                            <Button Style="{StaticResource ToolButton}" Content="Save Markdown…" Command="{Binding SaveMarkdownCommand}"
                                    AutomationProperties.AutomationId="SaveMarkdownButton"
                                    ToolTip="A .md file plus a folder with the screenshots"/>
                            <Button Style="{StaticResource ToolButton}" Content="Copy as text" Command="{Binding CopyTextCommand}"
                                    AutomationProperties.AutomationId="CopyReportTextButton"
                                    ToolTip="Markdown text without images, to paste into Jira, Azure DevOps or GitHub"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"
                                   AutomationProperties.AutomationId="BugReportStatus"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock" x:Key="FieldLabel">
                                    <Setter Property="Margin" Value="0,8,0,3"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Margin" Value="0,3"/>
                                </Style>
                                <Style TargetType="StackPanel" x:Key="SubOptions">
                                    <Setter Property="Margin" Value="22,0,0,2"/>
                                </Style>
                            </StackPanel.Resources>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Title" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding Title}" AutomationProperties.AutomationId="ReportTitle" AutomationProperties.Name="Title" Padding="3"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Severity"/>
                            <ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}" HorizontalAlignment="Left" MinWidth="140"
                                      AutomationProperties.AutomationId="ReportSeverity" AutomationProperties.Name="Severity"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Expected result"/>
                            <TextBox Text="{Binding Expected}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" Padding="3"
                                     AutomationProperties.AutomationId="ReportExpected" AutomationProperties.Name="Expected result"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Actual result"/>
                            <TextBox Text="{Binding Actual}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" Padding="3"
                                     AutomationProperties.AutomationId="ReportActual" AutomationProperties.Name="Actual result"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Notes"/>
                            <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" Padding="3"
                                     AutomationProperties.AutomationId="ReportNotes" AutomationProperties.Name="Notes"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Include in the report" Margin="0,14,0,3"/>
                            <CheckBox Content="Steps to reproduce" IsChecked="{Binding IncludeSteps}" AutomationProperties.AutomationId="IncludeSteps"/>
                            <StackPanel Style="{StaticResource SubOptions}" IsEnabled="{Binding IncludeSteps}">
                                <CheckBox Content="Screenshots" IsChecked="{Binding IncludeScreenshots}" AutomationProperties.AutomationId="IncludeScreenshots"/>
                                <StackPanel Style="{StaticResource SubOptions}" IsEnabled="{Binding IncludeScreenshots}">
                                    <CheckBox Content="Outline the element of each step" IsChecked="{Binding HighlightElement}" AutomationProperties.AutomationId="HighlightElement"/>
                                </StackPanel>
                            </StackPanel>
                            <CheckBox Content="Expected and actual result" IsChecked="{Binding IncludeExpectedActual}" AutomationProperties.AutomationId="IncludeExpectedActual"/>
                            <CheckBox Content="Severity" IsChecked="{Binding IncludeSeverity}" AutomationProperties.AutomationId="IncludeSeverity"/>
                            <CheckBox Content="Notes" IsChecked="{Binding IncludeNotes}" AutomationProperties.AutomationId="IncludeNotes"/>
                            <CheckBox Content="Environment" IsChecked="{Binding IncludeEnvironment}" AutomationProperties.AutomationId="IncludeEnvironment"/>
                            <StackPanel Style="{StaticResource SubOptions}" IsEnabled="{Binding IncludeEnvironment}">
                                <CheckBox Content="Windows version" IsChecked="{Binding IncludeWindowsVersion}" AutomationProperties.AutomationId="IncludeWindowsVersion"/>
                                <CheckBox Content="App name and version" IsChecked="{Binding IncludeAppVersion}" AutomationProperties.AutomationId="IncludeAppVersion"/>
                                <CheckBox Content="App install path" IsChecked="{Binding IncludeAppPath}" AutomationProperties.AutomationId="IncludeAppPath"/>
                                <CheckBox Content="Screens and scaling" IsChecked="{Binding IncludeScreens}" AutomationProperties.AutomationId="IncludeScreens"/>
                                <CheckBox Content="Language" IsChecked="{Binding IncludeLanguage}" AutomationProperties.AutomationId="IncludeLanguage"/>
                                <CheckBox Content="Date and time" IsChecked="{Binding IncludeDateTime}" AutomationProperties.AutomationId="IncludeDateTime"/>
                            </StackPanel>
                            <CheckBox Content="Element details (selectors, for developers)" IsChecked="{Binding IncludeElementDetails}" AutomationProperties.AutomationId="IncludeElementDetails"/>
                            <CheckBox Content="Automation script that reproduces it" IsChecked="{Binding IncludeScript}" AutomationProperties.AutomationId="IncludeScript"/>
                            <StackPanel Style="{StaticResource SubOptions}" IsEnabled="{Binding IncludeScript}">
                                <ComboBox ItemsSource="{Binding ScriptLanguages}" SelectedItem="{Binding SelectedScriptLanguage}" HorizontalAlignment="Left" MinWidth="200"
                                          AutomationProperties.AutomationId="ReportScriptLanguage" AutomationProperties.Name="Script language" Margin="0,3"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasScreenshots, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Screenshots per step" Margin="0,14,0,0"/>
                                <TextBlock Text="Untick any that show something private." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                <ItemsControl ItemsSource="{Binding StepScreenshots}" IsEnabled="{Binding IncludeScreenshots}"
                                              AutomationProperties.AutomationId="StepScreenshots" AutomationProperties.Name="Screenshots per step">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:StepScreenshotChoice}">
                                            <CheckBox IsChecked="{Binding Include}" Margin="0,2">
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                <!-- The preview shows the exact HTML that Save HTML writes -->
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Margin="2,0,0,6">
                        <Run Text="Preview" FontWeight="SemiBold"/><Run Text="  exactly what Save HTML writes" Foreground="{StaticResource MutedBrush}"/>
                    </TextBlock>
                    <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                        <WebBrowser x:Name="PreviewBrowser" AutomationProperties.AutomationId="ReportPreview" AutomationProperties.Name="Report preview"/>
                    </Border>
                </DockPanel>
            </Grid>
        </TabItem>
        </TabControl>
    </DockPanel>
</Window>
