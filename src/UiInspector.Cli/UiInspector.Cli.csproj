<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>uiinspect</AssemblyName>
    <RootNamespace>UiInspector.Cli</RootNamespace>
    <!-- Per-monitor DPI v2: cursor and UIA coordinates are both physical pixels. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiInspector.Core\UiInspector.Core.csproj" />
  </ItemGroup>

</Project>
